# The ui-kit's Storybook as a static site, served by nginx (caddy routes STORYBOOK_DOMAIN to it)
FROM node:25-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

WORKDIR /app

COPY pnpm-lock.yaml ./

# pnpm fetch downloads packages to the store, based on the lock file
RUN pnpm fetch

COPY . .

# offline forces pnpm to use packages from the store instead of downloading from the internet
RUN pnpm install --frozen-lockfile --offline

ENV NX_DAEMON=false

RUN pnpm exec nx run ui-kit:build-storybook

# Precompress text assets so nginx can serve them via gzip_static
RUN find packages/frontend/ui-kit/storybook-static -type f \
    \( -name "*.html" -o -name "*.js" -o -name "*.css" -o -name "*.svg" -o -name "*.json" \) \
    -exec gzip -9 -k {} +

FROM nginx:alpine AS runner

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/packages/frontend/ui-kit/storybook-static/ /usr/share/nginx/html/

COPY docker/nginx.storybook.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
