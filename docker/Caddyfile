{$DOMAIN} {
    encode zstd gzip
    reverse_proxy task-manager:80
}

# The REST backend. The frontend calls it cross-origin, so main-service answers CORS itself.
# /internal/* (service-to-service endpoints) and /webhooks/* (authentik calls them over the
# private network) stay off the internet.
api.{$DOMAIN} {
    encode zstd gzip

    @private path /internal/* /webhooks/*
    handle @private {
        respond 404
    }

    handle {
        reverse_proxy main-service:8080
    }
}

# Phoenix sockets (e.g. wss://socket.{$DOMAIN}/socket/websocket); paths are passed through as is.
# The page's origin is checked by Phoenix (`check_origin`), not here.
socket.{$DOMAIN} {
    reverse_proxy socket-server:4000
}

# Storage has its own origin, so files uploaded by users can never run in the app's origin.
# Exposed: uploads, file downloads and the Swagger UI (/api, spec at /api/openapi.json).
# /internal/* stays on the private network, and anything else answers 404 here instead of
# reaching the service.
# No `encode`: media is already compressed, and the service handles Range requests itself.
storage.{$DOMAIN} {
    @public path /files/* /public/files/* /actions/* /api /api/*

    handle @public {
        reverse_proxy storage-service:8082
    }

    handle {
        respond 404
    }
}

auth.{$DOMAIN} {
    reverse_proxy authentik_server:9000
}
