{$DOMAIN} {
    encode zstd gzip

    # Phoenix sockets live under /socket (e.g. /socket/websocket); the path is passed through as is
    handle /socket/* {
        reverse_proxy socket-server:4000
    }

    handle {
        reverse_proxy task-manager:80
    }
}

# Storage has its own origin, so files uploaded by users can never run in the app's origin.
# Only what a browser needs is exposed: uploads and file downloads. /internal/* and the Swagger UI
# stay on the private network, and anything else answers 404 here instead of reaching the service.
# No `encode`: media is already compressed, and the service handles Range requests itself.
storage.{$DOMAIN} {
    @browser path /files/* /public/files/* /actions/*

    handle @browser {
        reverse_proxy storage-service:8082
    }

    handle {
        respond 404
    }
}

auth.{$DOMAIN} {
    reverse_proxy authentik_server:9000
}
