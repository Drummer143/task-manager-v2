# Builds a release of one umbrella app: --build-arg APP_NAME=<app> (must match a release in mix.exs)
ARG ELIXIR_IMAGE=hexpm/elixir:1.18.4-erlang-27.3.4.16-debian-trixie-20260824-slim
ARG RUNNER_IMAGE=debian:trixie-20260824-slim

FROM ${ELIXIR_IMAGE} AS builder

RUN apt-get update -y && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=prod

ARG APP_NAME
RUN test -n "$APP_NAME" || (echo "APP_NAME build arg is required" && exit 1)

# Dependencies first, so source changes do not invalidate this layer
COPY mix.exs mix.lock ./
COPY apps/${APP_NAME}/mix.exs apps/${APP_NAME}/
RUN mix deps.get --only $MIX_ENV

COPY config/config.exs config/${MIX_ENV}.exs config/
RUN mix deps.compile

COPY apps/${APP_NAME} apps/${APP_NAME}
RUN mix compile

# runtime.exs does not affect compilation
COPY config/runtime.exs config/
RUN mix release ${APP_NAME}

FROM ${RUNNER_IMAGE} AS runner

RUN apt-get update -y && apt-get install -y --no-install-recommends libstdc++6 openssl libncurses6 locales ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    MIX_ENV=prod \
    PHX_SERVER=true

WORKDIR /app
RUN chown nobody /app

ARG APP_NAME
COPY --from=builder --chown=nobody:root /app/_build/prod/rel/${APP_NAME} ./
RUN ln -s /app/bin/${APP_NAME} /app/bin/app

USER nobody

CMD ["/app/bin/app", "start"]
