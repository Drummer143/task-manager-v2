{
  "name": "main_service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/main_service/src",
  "projectType": "application",
  "tags": ["lang:rust"],
  "namedInputs": {
    "rust": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p main_service --release",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "cargo run -p main_service",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rust"],
      "options": {
        "command": "cargo test -p main_service",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rust"],
      "options": {
        "commands": [
          "cargo fmt -p main_service -- --check",
          "cargo clippy -p main_service --all-targets -- -D warnings"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p main_service",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
