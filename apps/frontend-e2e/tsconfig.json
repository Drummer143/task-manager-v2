{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The fakes take their types from workspace sources (path aliases), like apps/frontend
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "../..",
    "outDir": "../../dist/out-tsc",
    "sourceMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "src/**/*.ts"]
}
