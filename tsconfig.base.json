{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@task-manager-v2/source"],
    "paths": {
      "@task-manager-v2/ui-kit": ["./packages/frontend/ui-kit/src/index.ts"],
      "@task-manager-v2/ui-kit/icons": ["./packages/frontend/ui-kit/src/icons/index.ts"],
      "@task-manager-v2/ui-kit/tokens.css": ["./packages/frontend/ui-kit/src/tokens/tokens.css"],
      "@task-manager-v2/ui-kit/testing": ["./packages/frontend/ui-kit/src/testing/jsdom.ts"],
      "@task-manager-v2/api": ["./packages/frontend/api/src/index.ts"],
      "@task-manager-v2/api/*": ["./packages/frontend/api/src/generated/*"],
      "@task-manager-v2/uploader": ["./packages/frontend/uploader/src/index.ts"]
    }
  }
}
