[
  {
    "name": "task-manager",
    "dockerfile": "docker/Dockerfile.frontend",
    "compose_service": "task-manager",
    "paths": [
      "apps/frontend/**",
      "packages/frontend/**",
      "package.json",
      "pnpm-lock.yaml",
      "nx.json",
      "tsconfig.base.json",
      ".dockerignore",
      "docker/Dockerfile.frontend",
      "docker/nginx.frontend.conf"
    ]
  },
  {
    "name": "main-service",
    "dockerfile": "docker/Dockerfile.rust",
    "compose_service": "main-service",
    "build_args": "APP_NAME=main_service",
    "paths": [
      "apps/main_service/**",
      "packages/rust/**",
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".dockerignore",
      "docker/Dockerfile.rust"
    ]
  },
  {
    "name": "storage-service",
    "dockerfile": "docker/Dockerfile.rust",
    "compose_service": "storage-service",
    "build_args": "APP_NAME=storage",
    "paths": [
      "apps/storage_service/**",
      "packages/rust/**",
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".dockerignore",
      "docker/Dockerfile.rust"
    ]
  },
  {
    "name": "socket-service",
    "dockerfile": "docker/Dockerfile.elixir",
    "compose_service": "socket-service",
    "build_args": "APP_NAME=socket_service",
    "paths": [
      "apps/socket_service/**",
      "config/**",
      "mix.exs",
      "mix.lock",
      ".dockerignore",
      "docker/Dockerfile.elixir"
    ]
  }
]
