# Environment for running backend services locally against the VPS over an SSH tunnel.
# Copy to .env.tunnel and fill in your values. Open the SSH tunnel first:
# Postgres (5432) and Authentik (9000) are forwarded to localhost.

# ===================
# main-service
# ===================
MAIN_SERVICE_PORT=8080
MAIN_SERVICE_HOST=127.0.0.1
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/task_manager
AUTHENTIK_JWKS_URL=http://localhost:9000/application/o/task-manager/jwks/
AUTHENTIK_AUDIENCE=YOUR_AUTHENTIK_CLIENT_ID
AUTHENTIK_ISSUER=https://auth.YOUR_DOMAIN/application/o/task-manager/

# ===================
# storage-service
# ===================
STORAGE_SERVICE_PORT=8082
STORAGE_SERVICE_HOST=127.0.0.1
STORAGE_SERVICE_STATIC_FOLDER_PATH=./apps/backend/storage/static
MAIN_SERVICE_URL=http://localhost:8080

# ===================
# socket-service (Elixir)
# ===================
SECRET_KEY_BASE=changeme_generate_with_mix_phx_gen_secret
