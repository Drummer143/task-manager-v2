# Environment for running services locally against the VPS over an SSH tunnel.
# Copy to .env.tunnel and fill in your values. Then, in two terminals:
#   .\scripts\tunnel.ps1                  # postgres 5432, redis 6379, authentik 9000 -> localhost
#   .\scripts\dev-tunnel.ps1 <service>    # main | storage | socket | frontend
#
# The databases behind the tunnel are production's: what local services write is real data.

# user@host of the VPS, used by tunnel.ps1 when no host is passed
TUNNEL_SSH_HOST=root@YOUR_VPS

# ===================
# main-service
# ===================
MAIN_SERVICE_HOST=127.0.0.1
MAIN_SERVICE_PORT=8080
DATABASE_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB_NAME
# Keep false: migrations of a local branch must not reach the VPS database (once applied there,
# editing them makes the deployed main-service refuse to start)
RUN_MIGRATIONS=false
# authentik's webhooks go to the deployed main-service, so any value works locally
USER_SYNC_WEBHOOK_TOKEN=local-only
CORS_ORIGINS=http://localhost:1346

# ===================
# storage-service (port 8082)
# ===================
# DATABASE_URL above is shared
REDIS_URL=redis://localhost:6379
# Keep false: the cleanups would delete the deployed storage-service's transactions and blobs
RUN_BACKGROUND_WORKERS=false
AUTHENTIK_JWKS_URL=http://localhost:9000/application/o/task-manager/jwks/
AUTHENTIK_AUDIENCE=YOUR_AUTHENTIK_CLIENT_ID
# Files uploaded locally stay on this machine; files uploaded on the VPS cannot be served here
STATIC_FOLDER_PATH=./tmp/storage
STORAGE_PUBLIC_URL=http://localhost:8082
# The local main-service; run it too when storage needs it (upload completion, file links)
MAIN_SERVICE_URL=http://localhost:8080
# Must match what main-service uses; any values when both run locally
INTERNAL_SERVICE_TOKEN=local-only-internal-service-token
JWT_SECRET=local-only-jwt-secret
# At least 32 bytes
FILE_LINK_SECRET=local-only-file-link-secret-0123456789

# ===================
# socket-server (apps/socket_server)
# ===================
SOCKET_SERVER_PORT=4000
