{
  "name": "api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/frontend/api/src",
  "projectType": "library",
  "tags": ["frontend"],
  "// targets": "to see all targets run: nx show project api --web",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/frontend/api",
        "command": "orval --config ./orval.config.ts"
      },
      "inputs": ["{projectRoot}/orval.config.ts", "{projectRoot}/specs/*.json", "{projectRoot}/src/fetcher.ts"],
      "outputs": ["{projectRoot}/src/generated"]
    },
    "generate-local": {
      "description": "Exports the specs from the services' code first, then generates",
      "executor": "nx:run-commands",
      "dependsOn": ["storage:export-openapi", "main_service:export-openapi"],
      "options": {
        "cwd": "packages/frontend/api",
        "command": "orval --config ./orval.config.ts"
      }
    }
  }
}
