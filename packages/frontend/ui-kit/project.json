{
  "name": "ui-kit",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/frontend/ui-kit/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project ui-kit --web",
  "targets": {
    "storybook": {
      "options": {
        "args": ["--port=6006", "--no-open"]
      }
    },
    "generate-tokens": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/frontend/ui-kit",
        "command": "node tools/generate-tokens.mjs"
      },
      "inputs": [
        "{projectRoot}/src/tokens/tokens.css",
        "{projectRoot}/tools/generate-tokens.mjs"
      ],
      "outputs": [
        "{projectRoot}/src/tokens/tokens.generated.ts",
        "{projectRoot}/src/tokens/tokens.generated.scss"
      ]
    },
    "check-tokens": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/frontend/ui-kit",
        "command": "node tools/generate-tokens.mjs --check"
      }
    }
  }
}
