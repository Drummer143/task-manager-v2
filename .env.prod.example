# Production environment for docker/docker-compose.prod.yml
# Copy to .env.site, fill in real values and run:
#   docker compose -f docker/docker-compose.prod.yml --env-file .env.site up -d
# Variables marked (required) make `docker compose` fail fast when missing.

# ===================
# Shared: caddy, authentik, socket-server
# ===================
DOMAIN=example.com

# ===================
# Frontend image: task-manager
# ===================
IMAGE_TAG=latest

# Build-time args for docker/Dockerfile.frontend (only used by `docker compose build`)
# VITE_AUTHORITY=https://auth.example.com/application/o/task-manager/
# VITE_CLIENT_ID=changeme
# VITE_REDIRECT_URI=https://example.com/auth/callback
# VITE_POST_LOGOUT_REDIRECT_URI=https://example.com/

# ===================
# PostgreSQL: postgres, postgres-init (required)
# ===================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB_NAME=task_manager

# ===================
# RabbitMQ: rmq (required)
# ===================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=changeme

# ===================
# Authentik: authentik_server, authentik_worker, postgres-init (required)
# ===================
AUTHENTIK_SECRET_KEY=changeme_generate_with_openssl_rand_base64_60
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_PASSWORD=changeme

# Read by authentik blueprints (docker/authentik/blueprints) via !Env
AUTHENTIK_SLUG=task-manager
AUTHENTIK_CLIENT_ID=changeme
AUTHENTIK_REDIRECT_URI=https://example.com/auth/callback
AUTHENTIK_REDIRECT_URI_SILENT=https://example.com/auth/silent-callback
# Second redirect pair, e.g. for local frontend dev against prod authentik
AUTHENTIK_REDIRECT_URI_2=http://localhost:1346/auth/callback
AUTHENTIK_REDIRECT_URI_2_SILENT=http://localhost:1346/auth/silent-callback
AUTHENTIK_NOTIFICATION_WEBHOOK_USER_SYNC=http://main-service:8080/webhooks/authentik/user_sync

# ===================
# Main service: main-service (required)
# MAIN_SERVICE_HOST and MAIN_SERVICE_PORT are set by the compose file
# ===================
DATABASE_URL=postgres://postgres:changeme@postgres:5432/task_manager

# ===================
# Socket server: socket-server (required)
# SOCKET_SERVER_PORT and PHX_HOST are set by the compose file
# ===================
SECRET_KEY_BASE=changeme_generate_with_mix_phx_gen_secret

# ===================
# Backend services (not part of docker-compose.prod.yml yet)
# ===================

# main-service, notification-service
RABBITMQ_URL=amqp://guest:changeme@rmq:5672

# main-service
JWT_SECRET=changeme
AUTHENTIK_JWKS_URL=http://authentik_server:9000/application/o/task-manager/jwks/
AUTHENTIK_AUDIENCE=changeme
AUTHENTIK_ISSUER=https://auth.example.com/application/o/task-manager/
AUTHENTIK_API_URL=http://authentik_server:9000/api/v3
AUTHENTIK_API_TOKEN=changeme
STORAGE_SERVICE_URL=http://storage-service:8082

# storage-service
STORAGE_SERVICE_PORT=8082
STORAGE_SERVICE_HOST=0.0.0.0
STORAGE_SERVICE_STATIC_FOLDER_PATH=/static

# calls-service
CALLS_SERVICE_PORT=8084
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme
