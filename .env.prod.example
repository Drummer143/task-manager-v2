# Production environment for docker/docker-compose.prod.yml
# Copy to .env.site, fill in real values and run:
#   docker compose -f docker/docker-compose.prod.yml --env-file .env.site up -d
# Variables marked (required) make `docker compose` fail fast when missing.

# ===================
# Shared: caddy, authentik, socket-service
# ===================
DOMAIN=example.com

# ===================
# Frontend image: task-manager
# ===================
IMAGE_TAG=latest

# Build-time args for docker/Dockerfile.frontend (only used by `docker compose build`; CI takes
# them from repository variables). Redirect URIs are derived from the page's origin.
# VITE_AUTHORITY=https://auth.example.com/application/o/task-manager/
# VITE_CLIENT_ID=changeme
# VITE_API_URL=https://api.example.com

# ===================
# PostgreSQL: postgres, postgres-init (required)
# ===================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB_NAME=task_manager

# ===================
# RabbitMQ: rmq (required)
# ===================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=changeme

# ===================
# Authentik: authentik_server, authentik_worker, postgres-init (required)
# ===================
AUTHENTIK_SECRET_KEY=changeme_generate_with_openssl_rand_base64_60
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_PASSWORD=changeme

# Read by authentik blueprints (docker/authentik/blueprints) via !Env
AUTHENTIK_SLUG=task-manager
AUTHENTIK_CLIENT_ID=changeme
AUTHENTIK_REDIRECT_URI=https://example.com/auth/callback
AUTHENTIK_REDIRECT_URI_SILENT=https://example.com/auth/silent-callback
# Second redirect pair, e.g. for local frontend dev against prod authentik
AUTHENTIK_REDIRECT_URI_2=http://localhost:1346/auth/callback
AUTHENTIK_REDIRECT_URI_2_SILENT=http://localhost:1346/auth/silent-callback
# Where authentik returns after sign-out: the frontend's /login, for prod and local dev
AUTHENTIK_POST_LOGOUT_REDIRECT_URI=https://example.com/login
AUTHENTIK_POST_LOGOUT_REDIRECT_URI_2=https://localhost:1346/login

AUTHENTIK_NOTIFICATION_WEBHOOK_USER_SYNC=http://main-service:8080/webhooks/authentik/user_sync

# ===================
# Main service: main-service (required)
# MAIN_SERVICE_HOST and MAIN_SERVICE_PORT are set by the compose file
# ===================
DATABASE_URL=postgres://postgres:changeme@postgres:5432/task_manager

# authentik sends it with the user sync webhook, main-service rejects the webhook without it
# (required by both). Generate with: openssl rand -hex 32
USER_SYNC_WEBHOOK_TOKEN=changeme_generate_with_openssl_rand_hex_32

# ===================
# Socket server: socket-service (required)
# SOCKET_SERVER_PORT and PHX_HOST are set by the compose file
# ===================
SECRET_KEY_BASE=changeme_generate_with_mix_phx_gen_secret

# ===================
# Storage service: storage-service, redis (required)
# Also reads DATABASE_URL (main service section), DOMAIN, and JWT_SECRET, AUTHENTIK_JWKS_URL and
# AUTHENTIK_AUDIENCE (below). Port 8082, STATIC_FOLDER_PATH, MAIN_SERVICE_URL, STORAGE_PUBLIC_URL
# and CORS_ORIGINS are set by the compose file
# Optional log filter (RUST_LOG syntax), defaults to info. Set to debug while investigating
# STORAGE_RUST_LOG=info
# ===================
REDIS_URL=redis://redis:6379

# Shared secret between backend services; protects the /internal/* endpoints and authenticates
# storage-service's calls to main-service. main-service must use the same value once it
# implements those endpoints. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=changeme_generate_with_openssl_rand_hex_32

# Signs links to private files; known to storage-service only. At least 32 bytes.
# Generate with: openssl rand -hex 32
FILE_LINK_SECRET=changeme_generate_with_openssl_rand_hex_32

# How long a private file link stays valid, in seconds (default 3600)
# FILE_LINK_TTL_SECONDS=3600

# ===================
# Backend services (not part of docker-compose.prod.yml yet)
# ===================

# main-service, socket-service
AMQP_URL=amqp://guest:changeme@rmq:5672

# main-service issues upload tokens signed with JWT_SECRET, storage-service verifies them (required
# by storage-service). AUTHENTIK_JWKS_URL and AUTHENTIK_AUDIENCE (the frontend's client id) are
# required by main-service and storage-service; both check AUTHENTIK_ISSUER when it is set
JWT_SECRET=changeme
AUTHENTIK_JWKS_URL=http://authentik_server:9000/application/o/task-manager/jwks/
AUTHENTIK_AUDIENCE=changeme

# main-service
AUTHENTIK_ISSUER=https://auth.example.com/application/o/task-manager/
AUTHENTIK_API_URL=http://authentik_server:9000/api/v3
AUTHENTIK_API_TOKEN=changeme
STORAGE_SERVICE_URL=http://storage-service:8082
